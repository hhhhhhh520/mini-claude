# LLM Provider Configuration
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# OpenAI-compatible gateway base URL
OPENAI_BASE_URL=https://tokenrhythm.studio/v1

# Default model（本机联调示例用 qwen3.8-flash；
# 码内兜底是 deepseek-v4-flash，见 llm_settings.py，不填本项即用兜底）
DEFAULT_MODEL=qwen3.8-flash

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434

# Agent settings
MAX_SUB_AGENTS=3
MAX_ITERATIONS=10
